<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <!-- Avatar circle -->
            <TextView android:layout_width="38dp" android:layout_height="38dp"
                android:id="@+id/tv_comment_user"
                android:gravity="center" android:text="A"
                android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/bg_pill_dark"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView android:id="@+id/tv_comment_user_name"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Username" android:textColor="@color/text_primary"
                    android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tv_comment_rating"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="★★★★★" android:textColor="@color/yellow_star" android:textSize="12sp"/>
            </LinearLayout>

            <TextView android:id="@+id/tv_comment_date"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="2025-01-01" android:textColor="@color/text_hint" android:textSize="11sp"
                android:layout_marginEnd="6dp"/>
            <ImageButton android:id="@+id/btn_delete_comment"
                android:layout_width="24dp" android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete" android:src="@android:drawable/ic_menu_delete"
                android:tint="#BDBDBD"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_comment_text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Review text" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:lineSpacingExtra="2dp" android:layout_marginTop="10dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
